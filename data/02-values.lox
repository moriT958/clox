print true;       // true
print false;      // false
print nil;        // nil

print 1 < 2;      // true
print 2 <= 2;     // true
print 3 > 4;      // false

print 1 == 1;     // true
print 1 != 2;     // true
print 1 == "1";   // false
print nil == nil; // true

print !true;      // false
print !nil;       // true
print !0;         // false
print !"";        // false
print !!nil;      // false
